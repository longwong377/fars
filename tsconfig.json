{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true, "noUnusedLocals": false, "skipLibCheck": true, "resolveJsonModule": true, "esModuleInterop": true,
    "isolatedModules": true, "types": ["vite/client", "node"], "allowImportingTsExtensions": false, "noEmit": true
  },
  "include": ["src", "tests", "tools"]
}
