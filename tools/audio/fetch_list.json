 "meta": {
  "what": "D-620: every recording the world plays (src/audio/soundplan.ts BED_LAYERS, ONESHOT_SETS, FOOT_SURFACES); tools/audio/fetch.mjs resolves each item by search, downloads, cuts, normalises, encodes to public/audio and writes the manifest, tools/audio/fetch_lock.json and the ASSET_LEDGER rows",
  "licences": "CC0 first; then CC BY; then CC BY-NC (CLAUDE.md section 12: personal, non-commercial use). No SA or ND unless ALLOW_SA=1. Every file credited in ASSET_LEDGER.md",
  "sources": "freesound (API with FREESOUND_TOKEN, else its search pages), Wikimedia Commons (API), archive.org (advanced search); in that order of preference, CC0 before CC BY at each; ESC-50 (github.com/karolpiczak/ESC-50 via raw.githubusercontent.com, reachable from the cloud): 5 s clips by class for the items with `esc50`, beds with `compose` as PROVISIONAL patchworks the full fetch replaces",
  "beds": "cut to `take` s (default 120) after skipping 2 s, stereo 48 kHz, high-passed at 40 Hz, loudness-normalised to -23 LUFS (two-pass, linear), Ogg Opus 48 kb/s",
  "oneshots_foot": "split into events by silence (each between 0.06 s and `max` s), the loudest `variants` kept, mono, peak -3 dBFS, Ogg Opus 40 kb/s",
  "reject": "any recording whose title, tags or description name a modern sound or speech (REJECT below, plus the item's own), and any bed whose envelope has the syllable-rate modulation of speech (speechiness > 5.5 dB: tools/audio/fetch.mjs speechiness)",
  "budget": "public/audio <= 40 MB on disk (D-620, agreed for C4: nothing loads before walkable; beds load when first wanted)"
 },
